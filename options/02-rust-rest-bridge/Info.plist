    <string>0.2.0</string>
    <key>CFBundleVersion</key>
    <string>0.2.0</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>switchbot-bridge requires Bluetooth to discover and control SwitchBot devices.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>switchbot-bridge requires Bluetooth to discover and control SwitchBot devices.</string>
</dict>
